<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Cybersecurity_Bot.MainWindow"
        Width="850"
        Height="650"
        Title="Cybersecurity Awareness Bot"
        Background="#101820">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="🛡 CYBERSECURITY AWARENESS BOT"
                       Foreground="Magenta"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Learn about passwords, phishing, scams, privacy, malware and safe browsing."
                       Foreground="White"
                       FontSize="14"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="#1E2A35"
                BorderBrush="LightGreen"
                BorderThickness="2"
                CornerRadius="8"
                Padding="10">

            <ScrollViewer>
                <TextBlock Name="ChatDisplay"
                           Foreground="LightGreen"
                           FontFamily="Consolas"
                           FontSize="15"
                           TextWrapping="Wrap"/>
            </ScrollViewer>

        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBox Name="UserInput"
                     Grid.Column="0"
                     Height="40"
                     FontSize="15"
                     VerticalContentAlignment="Center"/>

            <Button Name="SendButton"
                    Content="Send"
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Height="40"
                    FontWeight="Bold"
                    Background="LightGreen"
                    Foreground="Black"/>

            <Button Name="ClearButton"
                    Content="Clear"
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    Height="40"
                    FontWeight="Bold"
                    Background="LightGray"
                    Foreground="Black"/>

        </Grid>

    </Grid>
</Window>