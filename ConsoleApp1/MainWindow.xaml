<Window x:Class="Cybersecurity_Bot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot"
        Height="650"
        Width="850"
        WindowStartupLocation="CenterScreen"
        Background="#101820">

    <Grid Margin="15">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP TITLE AREA -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">

            <TextBlock Text="🛡 CYBERSECURITY AWARENESS BOT"
                       Foreground="Magenta"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Learn about passwords, phishing, scams, privacy, malware and safe browsing."
                       Foreground="White"
                       FontSize="14"
                       HorizontalAlignment="Center"
                       Margin="0,5,0,0"/>

        </StackPanel>

        <!-- CHAT DISPLAY AREA -->
        <Border Grid.Row="1"
                Background="#1E2A35"
                BorderBrush="LightGreen"
                BorderThickness="2"
                CornerRadius="8"
                Padding="10">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <TextBlock x:Name="ChatDisplay"
                           Foreground="LightGreen"
                           FontFamily="Consolas"
                           FontSize="15"
                           TextWrapping="Wrap"/>

            </ScrollViewer>

        </Border>

        <!-- INPUT AREA -->
        <Grid Grid.Row="2" Margin="0,10,0,0">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="120"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="UserInput"
                     Grid.Column="0"
                     Height="40"
                     FontSize="15"
                     VerticalContentAlignment="Center"
                     Padding="10,0,10,0"
                     KeyDown="UserInput_KeyDown"/>

            <Button x:Name="SendButton"
                    Content="Send"
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    Height="40"
                    FontWeight="Bold"
                    Background="LightGreen"
                    Foreground="Black"
                    Click="SendButton_Click"/>

            <Button x:Name="ClearButton"
                    Content="Clear"
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    Height="40"
                    FontWeight="Bold"
                    Background="LightGray"
                    Foreground="Black"
                    Click="ClearButton_Click"/>

        </Grid>

    </Grid>
</Window>